<?xml version="1.0" encoding="utf-8"?>
<!-- Feeds for the isolated package smoke: the local ../../nupkgs feed CI packs into,
     plus nuget.org for SkiaSharp et al. Scoped to this directory (NuGet walks up from
     the project), so it never affects the other jobs' builds. <clear/> drops any
     inherited sources so resolution is deterministic. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nupkgs" value="../../nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
